# GMPI New Product Cascading System — environment configuration
# Copy to .env locally, or set these in the Render dashboard. NEVER commit real values.

# PostgreSQL connection string. Render wires this automatically via render.yaml.
# For the one-time migration, use the EXTERNAL URL from the Render database page.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Secret used to sign login sessions. Render generates this automatically (generateValue).
# Locally it can be omitted (a random secret is used per boot).
# SESSION_SECRET=

# First administrator account, created only when the users table is empty.
# Choose these yourself; minimum password length 8. Required on Render.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# Optional: public base URL if you attach a custom domain (no trailing slash).
# PUBLIC_BASE_URL=https://cascading.yourcompany.com

# Local development only:
# PORT=3100
# DB_PATH=./data/app.db
# UPLOADS_DIR=./uploads